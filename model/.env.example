PORT=8000
DATABASE_PATH=data/planetx.db
COOKIE_SECURE=0          # خليها 1 على الاستضافة (HTTPS)
TRUST_PROXY=0            # خليها 1 لو ورا proxy (Render/Railway/Nginx)
ALLOWED_ORIGINS=         # دومينات إضافية مسموح تبعت POST (مفصولة بفاصلة)
MAX_SOURCES=6000
MODEL_BACKEND=custom     # custom = ML scorer (models/tracklet_mlp.json) | builtin = rule-based tracker | http
ML_THRESHOLD=            # اختياري: يغيّر حد القرار (أقل = يلاقي أكتر ويغلط أكتر)
MODEL_URL=               # لو http
MODEL_API_KEY=
MODEL_TIMEOUT=30
